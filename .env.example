# Agent Arena - Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see .gitignore).

# ============================================================
# REQUIRED
# ============================================================

# Postgres connection string. Used by lib/db/client.ts to
# auto-detect the backend (Neon serverless vs node-postgres).
# Neon URLs match *.neon.tech or *.neon.build hostnames.
#DATABASE_URL=your-postgres-url-here

# OpenAI API key. Used by lib/runtime/mastra.ts via the
# OpenAI SDK. Required for any agent model calls.
#OPENAI_API_KEY=your-openai-api-key-here

# ============================================================
# OPTIONAL
# ============================================================

# Default model identifier. Provider/model pattern.
# Used by the Mastra runtime when no per-agent override is set.
DEFAULT_MODEL=openai/gpt-5

# Per-battle time budget in milliseconds.
# Battle engine terminates rounds that exceed this limit.
BATTLE_DEFAULT_TIME_BUDGET_MS=240000

# Application log verbosity.
# One of: trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL=info

# Toggles example battle fixtures (PRD §8.3).
# Set to false in production to hide demo content.
ENABLE_EXAMPLE_BATTLES=true

# Interval in milliseconds between SSE heartbeat frames
# on the battle live stream.
SSE_HEARTBEAT_MS=15000

# ============================================================
# DEMO / E2E
# ============================================================

# Base URL Playwright targets during E2E runs.
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Override system Chromium path for Playwright.
# Leave unset to use the bundled Playwright browser.
#PLAYWRIGHT_CHROMIUM_PATH=

# ============================================================
# CI
# ============================================================

# Set automatically by GitHub Actions. Many tools (Vitest,
# Next.js, etc.) change behavior when CI is truthy. Do not
# set this manually in local dev.
#CI=
