{
  "name": "agent-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build",
    "start": "pnpm dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter @agent-arena/contracts typecheck && pnpm --filter api typecheck && pnpm --filter web typecheck",
    "test": "vitest run && pnpm --filter @agent-arena/contracts test && pnpm --filter api test && pnpm --filter web test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "openai": "^6.45.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "26.1.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "pg": "^8.22.0",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
